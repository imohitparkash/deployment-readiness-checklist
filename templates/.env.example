# .env.example
#
# Copy this file to `.env` and fill in real values locally.
# Never commit `.env` — it must be in .gitignore before your first commit.
# This file should only ever contain placeholder values, never real secrets.

# --- App ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgres://user:password@localhost:5432/dbname

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string
SESSION_SECRET=replace_with_a_long_random_string

# --- Third-party APIs ---
# API_KEY_SOME_SERVICE=

# --- Email / notifications (if applicable) ---
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# --- Cloud storage (if applicable) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET_NAME=

# --- Analytics / tracking (if applicable) ---
# ANALYTICS_ID=

# --- App ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DEBUG=false

# --- CORS ---
# Comma-separated list. Never use "*" in production — CHECKLIST.md Section 5.
ALLOWED_ORIGINS=http://localhost:3000

# Notes:
# - Use different values per environment (dev/staging/prod) — never share credentials across them.
# - In production, prefer a proper secrets manager (e.g. AWS Secrets Manager, Doppler, Vault)
#   or your host's environment variable settings over a plain .env file.